      propertyPath: 'callEntries.Array.data[2].lines.Array.data[3]'
      value: "\uB098\uC911\uC5D0 \uB354 \uB2E8\uB2E8\uD55C \uCF54\uD305\uC744 \uAE01\uC73C\uB824\uBA74
