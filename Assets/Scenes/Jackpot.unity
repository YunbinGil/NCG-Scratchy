      objectReference: {fileID: 0}
    - target: {fileID: 2471224355645944803, guid: b9e0f672665130549be9f9a5cac0ffb3, type: 3}
      propertyPath: 'callEntries.Array.data[2].lines.Array.data[4]'
      value: "\uC2EC\uC9C0\uC5B4 \uC6B4\uB3C4 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560
        \uC218 \uC788\uB2F5\uB2C8\uB2E4. \uC815\uB9D0 \uAD49\uC7A5\uD558\uC8E0!"
      objectReference: {fileID: 0}
    - target: {fileID: 2471224355645944803, guid: b9e0f672665130549be9f9a5cac0ffb3, type: 3}
      propertyPath: 'callEntries.Array.data[3].lines.Array.data[0]'
      value: "\uC640 \uC0C8\uB85C\uC6B4 \uD2F0\uCF13\uC774 \uC900\uBE44\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
