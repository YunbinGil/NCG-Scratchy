      propertyPath: 'callEntries.Array.data[3].lines.Array.data[2]'
      value: "\uB2F9\uCCA8\uB418\uB824\uBA74 \uC6B4\uC774 \uC880 \uB354 \uB530\uB77C\uC918\uC57C
        \uD560 \uAC81\uB2C8\uB2E4."
