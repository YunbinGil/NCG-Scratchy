      propertyPath: 'callEntries.Array.data[3].lines.Array.data[1]'
      value: "\uC774 \uD2F0\uCF13\uC740 \uBCF4\uC0C1\uC774 \uD6E8\uC52C \uB354 \uC9ED\uC9E4\uD558\uC9C0\uB9CC.."
