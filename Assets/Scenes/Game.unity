--- !u!114 &2471224354393948472
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 570624558046299410}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 06c849fba9422e34b8f23d51e368098f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PhoneEventController
  phoneCallTrigger: {fileID: 1254618633}
  callEntries:
  - entryName: 
    eventType: 0
    triggerOnlyOnce: 1
    lines:
    - "\uB9E4\uBC88 \uB538 \uC218\uB294 \uC5C6\uB294 \uBC95\uC774\uC8E0. \uAC00\uB054\uC740
      \uC190\uD574\uB97C \uBCFC \uC218\uB3C4 \uC788\uC744 \uAC70\uC608\uC694. "
    - "\uADF8\uB798\uB3C4 \uAC71\uC815 \uB9C8\uC138\uC694. \uADF8\uB0E5 \uC4F0\uB808\uAE30\uD1B5\uC5D0
      \uBC84\uB9AC\uBA74 \uB418\uB2C8\uAE4C."
  - entryName: LEVEL 3
    eventType: 1
    triggerOnlyOnce: 1
    lines:
    - "\uBCF8\uC5C5\uC774 \uC9C0\uACB9\uB2E4\uACE0 \uB290\uAEF4\uC9C0\uC2DC\uB098\uC694?"
    - "\uADF8\uB807\uB2E4\uBA74 \uB531 \uB9DE\uB294 \uAC8C \uC788\uB294\uB370.."
    - "\uBC14\uB85C \uC2A4\uD06C\uB798\uCE58 \uBCF5\uAD8C\uC774\uB78D\uB2C8\uB2E4!"
  - entryName: LEVEL 4
    eventType: 2
    triggerOnlyOnce: 1
    lines:
    - "\uADF8\uAC70 \uC77C\uC77C\uC774 \uAE01\uC73C\uB824\uB2C8 \uC2DC\uAC04\uC774
      \uAF64 \uAC78\uB9AC\uC8E0?"
    - "\uAC71\uC815 \uB9C8\uC138\uC694, \uB2F9\uC2E0\uC5D0\uAC8C \uD544\uC694\uD55C
      \uAC78 \uC900\uBE44\uD588\uC73C\uB2C8\uAE4C\uC694. \uBC14\uB85C \uC5C5\uADF8\uB808\uC774\uB4DC\uC8E0!"
    - "\uC2A4\uD06C\uB798\uCE58 \uB3C4\uAD6C\uB97C \uC5C5\uADF8\uB808\uC774\uB4DC\uD558\uBA74
      \uD6E8\uC52C \uD3B8\uD558\uAC8C \uAE01\uC744 \uC218 \uC788\uC5B4\uC694!"
    - "\uB098\uC911\uC5D0 \uB354 \uB2E8\uB2E8\uD55C \uCF54\uD305\uC744 \uAE01\uC73C\uB824\uBA74
      \uB354 \uAC15\uD55C \uD798\uC774 \uD544\uC694\uD560 \uAC70\uC608\uC694.."
    - "\uC2EC\uC9C0\uC5B4 \uC6B4\uB3C4 \uC5C5\uADF8\uB808\uC774\uB4DC\uD560 \uC218
      \uC788\uB2F5\uB2C8\uB2E4. \uC815\uB9D0 \uAD49\uC7A5\uD558\uC8E0!"
  - entryName: LEVEL 5
    eventType: 3
    triggerOnlyOnce: 1
    lines:
    - "\uC640 \uC0C8\uB85C\uC6B4 \uD2F0\uCF13\uC774 \uC900\uBE44\uB418\uC5C8\uC2B5\uB2C8\uB2E4!"
    - "\uC774 \uD2F0\uCF13\uC740 \uBCF4\uC0C1\uC774 \uD6E8\uC52C \uB354 \uC9ED\uC9E4\uD558\uC9C0\uB9CC.."
    - "\uB2F9\uCCA8\uB418\uB824\uBA74 \uC6B4\uC774 \uC880 \uB354 \uB530\uB77C\uC918\uC57C
      \uD560 \uAC81\uB2C8\uB2E4."
  - entryName: LEVEL 6
    eventType: 4
    triggerOnlyOnce: 1
    lines:
    - "\uC774 \uB9CE\uC740 \uD2F0\uCF13\uC744 \uC9C1\uC811 \uAE01\uB290\uB77C \uC9C0\uCE58\uC168\uB098\uC694?"
  - entryName: LEVEL 7
    eventType: 5
    triggerOnlyOnce: 1
    lines:
    - "\uC0AC\uACFC\uB098\uBB34\uB97C \uAE01\uC744 \uB550 \uBC8C\uB808\uB97C \uC870\uC2EC\uD558\uC138\uC694!"
    - "\uBC8C\uB808\uAC00 \uBCF4\uC774\uBA74 \uC808\uB300 \uAE01\uC9C0 \uB9C8\uC138\uC694!"
    - "\uBC8C\uB808\uAC00 \uB098\uC640\uB3C4 \uC644\uC804\uD788 \uB2E4 \uAE01\uC5C8\uC744
      \uB54C\uB9CC \uC190\uD574\uAC00 \uBC1C\uC0DD\uD574\uC694."
